{
  "name": "bioinfo-lab",

  //  부분을 본인의 GitHub 조직 또는 계정 이름(소문자)으로 바꾼다.
  // 이미지를 미리 만들어 두었으므로 학생은 내려받기만 하면 된다.
  "image": "ghcr.io/goshng/bioinfolab:2026a",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.autoSave": "afterDelay",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.renderWhitespace": "boundary"
      }
    }
  },

  // 처음 열릴 때 도구가 제대로 들어 있는지 확인해 준다.
  "postCreateCommand": "bash .devcontainer/check.sh",

  // 10주차 조립 실습 전까지는 2코어로 충분하다.
  // 4코어로 올리면 무료 사용 시간이 두 배로 빨리 줄어든다.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
